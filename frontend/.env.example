# Copy this file to `.env.local` and fill in your own values.
# All VITE_* vars are embedded in the client bundle at build time — only ever
# put publishable/anon keys here, never service-role or secret keys.

# Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to expose; protected by Row Level Security)
VITE_SUPABASE_KEY=

# Google Maps Platform browser key. Enable Geocoding, Places API (New), Routes,
# and Maps JavaScript API, then restrict the key to your HTTP referrer(s).
VITE_GOOGLE_MAPS_API_KEY=

# Web Push VAPID public key (generated in Phase 3). Safe to expose.
VITE_VAPID_PUBLIC_KEY=
